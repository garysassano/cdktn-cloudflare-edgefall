// Wrangler exclusively owns Worker code, Durable Object migrations, and static
// assets. CDKTN/OpenTofu creates the D1 and R2 backing resources. The production
// deploy script replaces the local D1 placeholder with the CDKTN output.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edgefall",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    },
    "traces": { "enabled": true, "head_sampling_rate": 1 }
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*", "/health", "/rooms/*", "/runs/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "GAME_ROOMS", "class_name": "EdgefallRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["EdgefallRoom"] }],
  "d1_databases": [
    {
      "binding": "RUNS",
      "database_name": "edgefall-runs",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "r2_buckets": [{ "binding": "REPLAYS", "bucket_name": "edgefall-replays" }]
}
