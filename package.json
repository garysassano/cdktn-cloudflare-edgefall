{
  "name": "cdktn-cloudflare-edgefall",
  "private": true,
  "packageManager": "pnpm@12.0.0",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "bundle": "pnpm client:build && wrangler deploy --dry-run --outdir dist/wrangler && pnpm worker:build",
    "cdktn": "cdktn",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm synth",
    "client:build": "node scripts/build-client.mjs",
    "deploy": "pnpm bundle && cdktn deploy --auto-approve",
    "destroy": "cdktn destroy --auto-approve",
    "dev": "pnpm client:build && wrangler dev",
    "diff": "pnpm bundle && cdktn diff",
    "format": "biome format --write .",
    "gen": "cdktn get",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "pretest": "pnpm bundle",
    "pretest:watch": "pnpm bundle",
    "synth": "pnpm bundle && cdktn synth",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/worker/tsconfig.json && tsc --noEmit -p src/client/tsconfig.json",
    "types": "wrangler types",
    "worker:build": "node scripts/build-worker.mjs"
  },
  "dependencies": {
    "cdktn": "^0.24.0",
    "constructs": "10.7.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/node": "^24.13.3",
    "cdktn-cli": "^0.24.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.0"
  }
}
